    function simulateMetadataExtraction(fileInput) {
      const file = fileInput.files && fileInput.files[0];
      if (!file) return;
      const name = file.name.toLowerCase();
      const docTypeSelect = document.getElementById('uploadDocType');
      if (name.includes('laporan') || name.includes('lp_')) {
        docTypeSelect.value = 'Laporan';
      } else {
        docTypeSelect.value = 'Kertas Kerja';
      }
      const cleanTitle = file.name.replace(/\.(pdf|docx|doc)$/i, '').replace(/^(KK_|Laporan_|LP_)/i, '').replace(/_/g, ' ');
      document.getElementById('extractedProgramName').value = cleanTitle || 'Program Pembangunan Pelajar Unit';
      showToast(`Metadata fail "${file.name}" berjaya diekstrak.`, 'info');
    }

    function triggerSampleFileExtraction() {
      const user = BackendService.getCurrentUser(currentSessionToken);
      const unitProgs = BackendService.getUserPrograms(currentSessionToken, {});
      const incompleteProg = unitProgs.find(p => p.status_dokumen !== 'LENGKAP') || unitProgs[0];

      if (incompleteProg) {
        document.getElementById('uploadProgramSelect').value = incompleteProg.program_id;
        document.getElementById('extractedProgramName').value = incompleteProg.nama_program;
      } else {
        document.getElementById('extractedProgramName').value = `Bengkel Pemantapan ${user.nama_unit} 2026`;
      }
      showToast('Metadata contoh telah diisi!', 'info');
    }

    function handleDocumentUploadSubmit(e) {
      e.preventDefault();
      try {
        const fileInput = document.getElementById('uploadFileInput');
        const jenis_dokumen = document.getElementById('uploadDocType').value;
        const program_id = document.getElementById('uploadProgramSelect').value;
        const extracted_nama_program = document.getElementById('extractedProgramName').value;
        const extracted_tarikh = document.getElementById('extractedDate').value;
        const extracted_disediakan_oleh = document.getElementById('extractedAuthor').value;
        const custom_drive_link = document.getElementById('uploadCustomDriveLink')?.value?.trim() || '';

        const fileName = (fileInput && fileInput.files && fileInput.files[0])
          ? fileInput.files[0].name
          : `${jenis_dokumen.replace(' ', '_')}_${extracted_nama_program.replace(/\s+/g, '_').slice(0, 28)}.pdf`;

        const result = BackendService.uploadUserDocument(currentSessionToken, {
          program_id,
          jenis_dokumen,
          nama_fail: fileName,
          extracted_nama_program,
          extracted_tarikh,
          extracted_disediakan_oleh,
          custom_drive_link
