    function handleUserChangePassword(e) {
      e.preventDefault();
      const user = BackendService.getCurrentUser(currentSessionToken);
      const dbUser = DB.PENGGUNA.find(u => u.user_id === user.user_id);
      const curr = document.getElementById('cpCurrent').value;
      const next = document.getElementById('cpNew').value;
      const conf = document.getElementById('cpConfirm').value;

      if (dbUser.password_hash !== curr) {
        showToast('Kata laluan semasa tidak tepat.', 'error');
        return;
      }
      if (next !== conf) {
        showToast('Kata laluan baharu dan pengesahan tidak sepadan.', 'error');
        return;
      }
      dbUser.password_hash = next;
      BackendService.logAudit(user, 'CHANGE_PASSWORD', 'SUCCESS', 'Pengguna menukar kata laluan sendiri');
      showToast('Kata laluan berjaya dikemaskini!', 'success');
      e.target.reset();
    }

