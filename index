      getDashboardStats(token, tahun = '2026') {
        const user = this.getCurrentUser(token);
        const isAdm = user.role === 'ADMIN';
        const targetUnit = isAdm ? 'ALL' : user.unit_id;

        const progs = DB.PROGRAM.filter(p => (isAdm || p.unit_id === targetUnit) && (tahun === 'ALL' || p.tahun === tahun));
        const docs = DB.DOKUMEN.filter(d => isAdm || d.unit_id === targetUnit);

        const ringkasanDana = DB.SUMBER_DANA.map(f => {
          const alloc = DB.PROGRAM.filter(p => p.dana_id === f.dana_id).reduce((s, x) => s + Number(x.peruntukan || 0), 0);
          return { ...f, baki: f.jumlah_peruntukan - alloc };
        });

        const dokumenTerkini = DB.DOKUMEN.slice(0, 5).map(d => ({
          ...d,
          nama_program: (DB.PROGRAM.find(p => p.program_id === d.program_id) || {}).nama_program || 'Program HEP',
          nama_unit: this.getUnitNameById(d.unit_id),
          masa_relatif: 'Baru sahaja'
        }));

        return {
          nama_unit: isAdm ? 'Semua Jabatan/Unit (ADMIN)' : user.nama_unit,
          jumlah_program: progs.length,
          jumlah_kertas_kerja: docs.filter(d => d.jenis_dokumen === 'Kertas Kerja').length,
          jumlah_laporan: docs.filter(d => d.jenis_dokumen === 'Laporan').length,
          ringkasan_dana: ringkasanDana,
          dokumen_terkini: dokumenTerkini
        };
      },
      saveSystemDriveSettings(token, payload) {
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK.');
        const driveId = this.extractGoogleIdFromUrl(payload.root_drive_url) || DB.TETAPAN_SISTEM.root_drive_folder_id;
        const sheetId = this.extractGoogleIdFromUrl(payload.spreadsheet_url) || DB.TETAPAN_SISTEM.spreadsheet_id;

        DB.TETAPAN_SISTEM.root_drive_url = payload.root_drive_url;
        DB.TETAPAN_SISTEM.root_drive_folder_id = driveId;
        DB.TETAPAN_SISTEM.root_folder_name = payload.root_folder_name || 'iDOC HEP';
        DB.TETAPAN_SISTEM.spreadsheet_url = payload.spreadsheet_url;
        DB.TETAPAN_SISTEM.spreadsheet_id = sheetId;
        DB.TETAPAN_SISTEM.web_app_url = payload.web_app_url;
        DB.TETAPAN_SISTEM.updated_at = this.nowStr();
        DB.TETAPAN_SISTEM.updated_by = user.full_name;

        this.logAudit(user, 'UPDATE_DRIVE_SETTINGS', 'SUCCESS', `Kemaskini Root Google Drive ID: ${driveId} & Spreadsheet ID: ${sheetId}`);
        return DB.TETAPAN_SISTEM;
      },
      updateDocumentDriveLink(token, documentId, urlOrId, folderPath) {
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK.');
        const doc = DB.DOKUMEN.find(d => d.document_id === documentId);
        if (!doc) throw new Error('Dokumen tidak ditemui.');
        const fileId = this.extractGoogleIdFromUrl(urlOrId);
        doc.drive_file_id = fileId;
        doc.drive_direct_url = urlOrId.startsWith('http') ? urlOrId : `https://drive.google.com/file/d/${fileId}/view`;
        doc.drive_folder_path = folderPath || doc.drive_folder_path;
        this.logAudit(user, 'UPDATE_DOCUMENT_DRIVE', 'SUCCESS', `Kemaskini Drive Link dokumen ${documentId} (File ID: ${fileId})`);
        return doc;
      },
      saveAdminProgram(token, payload) {
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK.');
        if (payload.program_id) {
          const prog = DB.PROGRAM.find(p => p.program_id === payload.program_id);
          if (prog) {
            prog.nama_program = payload.nama_program;
            prog.unit_id = payload.unit_id;
            prog.sesi = payload.sesi;
            prog.tarikh_mula = payload.tarikh_mula;
            prog.tarikh_tamat = payload.tarikh_tamat;
            prog.dana_id = payload.dana_id;
            prog.peruntukan = Number(payload.peruntukan);
            this.logAudit(user, 'UPDATE_PROGRAM', 'SUCCESS', `Kemaskini program ${prog.program_id}`);
            return prog;
          }
        }
        const newProg = {
          program_id: 'P2026' + String(DB.PROGRAM.length + 1).padStart(3, '0'),
          nama_program: payload.nama_program,
          tarikh_mula: payload.tarikh_mula,
          tarikh_tamat: payload.tarikh_tamat,
          tahun: '2026',
          sesi: payload.sesi || 'Sesi II 2025/2026',
          unit_id: payload.unit_id,
          dana_id: payload.dana_id || 'D001',
          peruntukan: Number(payload.peruntukan || 3000),
          belanja_sebenar: 0,
          disediakan_oleh: user.full_name,
          status_dokumen: 'BELUM UPLOAD',
          created_at: this.nowStr().slice(0, 10)
        };
        DB.PROGRAM.push(newProg);
        this.logAudit(user, 'CREATE_PROGRAM', 'SUCCESS', `Admin mencipta program baharu ${newProg.program_id} untuk unit ${payload.unit_id}`);
        return newProg;
      },
      deleteAdminProgram(token, programId) {
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK.');
        const idx = DB.PROGRAM.findIndex(p => p.program_id === programId);
        if (idx === -1) throw new Error('Program tidak ditemui.');
        const removed = DB.PROGRAM.splice(idx, 1)[0];
        DB.DOKUMEN = DB.DOKUMEN.filter(d => d.program_id !== programId);
        this.logAudit(user, 'DELETE_PROGRAM', 'SUCCESS', `Padam program ${programId}`);
        return removed;
      },
      getProgramReminderDetails(programId) {
        const prog = DB.PROGRAM.find(p => p.program_id === programId);
        if (!prog) throw new Error('Program tidak ditemui.');
        const docs = DB.DOKUMEN.filter(d => d.program_id === programId);
        const hasKK = docs.some(d => d.jenis_dokumen === 'Kertas Kerja');
        const hasLap = docs.some(d => d.jenis_dokumen === 'Laporan');
        const unitObj = DB.JABATAN_UNIT.find(u => u.unit_id === prog.unit_id);
        const unitName = unitObj ? unitObj.nama_unit : prog.unit_id;
        const pegawai = DB.PENGGUNA.find(u => u.unit_id === prog.unit_id && u.role === 'USER') || DB.PENGGUNA.find(u => u.role === 'USER');

        let missingText = '';
        if (!hasKK && !hasLap) missingText = 'Kertas Kerja & Laporan Program';
        else if (!hasKK) missingText = 'Kertas Kerja Program';
        else if (!hasLap) missingText = 'Laporan Program';
        else missingText = 'Semua dokumen telah lengkap disahkan';

        const message = `Assalamualaikum / Selamat Sejahtera ${pegawai ? pegawai.full_name : 'Pegawai'} (${unitName}),\n\nSukacita dimaklumkan bahawa program "${prog.nama_program}" (${prog.program_id}) masih mempunyai dokumen yang belum lengkap dimuat naik di iDOC HEP PTSS: [${missingText}].\n\nSila muat naik dokumen tersebut dengan segera. Terima kasih.`;

        return {
          program: prog,
          unitName,
          recipientName: pegawai ? pegawai.full_name : 'Pegawai Unit',
          recipientPhone: pegawai ? pegawai.phone : '60123456789',
          missingText,
          message
        };
      }
    };

