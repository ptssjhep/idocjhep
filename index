<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>iDOC HEP — Sistem Pengurusan Dokumen Jabatan Hal Ehwal Pelajar PTSS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f1f5f9;
      color: #0f172a;
    }
    .sidebar-gradient {
      background: linear-gradient(180deg, #001f54 0%, #003580 55%, #023e8a 100%);
    }
    .login-hero-bg {
      background: radial-gradient(circle at 20% 20%, #00509d 0%, #00296b 55%, #001845 100%);
    }
    .btn-primary-grad {
      background: linear-gradient(90deg, #0066ff 0%, #003cb3 100%);
      transition: all 0.2s ease;
    }
    .btn-primary-grad:hover {
      background: linear-gradient(90deg, #0052cc 0%, #002b80 100%);
      transform: translateY(-1px);
      box-shadow: 0 8px 20px -4px rgba(0, 102, 255, 0.45);
    }
    .unit-banner-grad {
      background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 55%, #bfdbfe 100%);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toastContainer" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- MODAL CONTAINER -->
  <div id="modalOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-40 hidden items-center justify-center p-4 overflow-y-auto">
    <div id="modalBox" class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-2xl w-full overflow-hidden my-8">
      <div class="px-6 py-4 bg-gradient-to-r from-blue-900 to-blue-700 text-white flex items-center justify-between">
        <h3 id="modalTitle" class="font-bold text-base sm:text-lg flex items-center gap-2"></h3>
        <button onclick="closeModal()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div id="modalContent" class="p-6 max-h-[80vh] overflow-y-auto"></div>
    </div>
  </div>

  <!-- =========================================================================
       SKRIN 1: LOG MASUK, PENDAFTARAN PENGGUNA & LUPA KATA LALUAN
       ========================================================================= -->
  <div id="authScreen" class="min-h-screen flex flex-col lg:flex-row">
    <!-- Panel Kiri: Identiti Korporat iDOC HEP PTSS -->
    <div class="lg:w-7/12 login-hero-bg text-white p-8 sm:p-12 lg:p-16 flex flex-col justify-between relative overflow-hidden">
      <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-blue-400/10 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-sky-300/10 blur-3xl pointer-events-none"></div>

      <!-- Baris Logo KPT & Politeknik -->
      <div class="relative z-10 flex flex-wrap items-center gap-4 sm:gap-6">
        <div class="flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/15">
          <i class="fa-solid fa-building-columns text-amber-400 text-2xl"></i>
          <div>
            <div class="text-[10px] uppercase tracking-widest text-blue-200 font-semibold">Kementerian Pendidikan Tinggi</div>
            <div class="text-xs font-bold tracking-wide">JABATAN PENDIDIKAN POLITEKNIK & KOLEJ KOMUNITI</div>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white/10 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/15">
          <i class="fa-solid fa-graduation-cap text-sky-300 text-2xl"></i>
          <div>
            <div class="text-xs font-extrabold tracking-wider text-white">POLITEKNIK MALAYSIA</div>
            <div class="text-[11px] text-sky-200 font-semibold">TUANKU SYED SIRAJUDDIN, PERLIS</div>
          </div>
        </div>
      </div>

      <!-- Tajuk Utama iDOC HEP -->
      <div class="relative z-10 my-10 lg:my-0">
        <div class="inline-flex items-center gap-3 mb-4">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-sky-400 to-blue-600 shadow-xl flex items-center justify-center border-2 border-white/80">
            <i class="fa-solid fa-file-shield text-3xl text-white"></i>
          </div>
          <div>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-sky-400/20 text-sky-200 border border-sky-300/30">
              VERSI 3.5 • KAWALAN AKSES JABATAN/UNIT (RBAC)
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mt-1">
              iDOC <span class="text-sky-300">HEP</span>
            </h1>
          </div>
        </div>

        <h2 class="text-xl sm:text-2xl font-bold text-blue-50 max-w-xl leading-snug">
          Sistem Pengurusan Dokumen Jabatan Hal Ehwal Pelajar
        </h2>
        <div class="inline-block mt-3 px-4 py-1.5 rounded-full bg-white/15 border border-white/25 text-sm font-semibold text-sky-100">
          Politeknik Tuanku Syed Sirajuddin, Perlis (PTSS)
        </div>

        <!-- 3 Ciri Utama -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8 max-w-2xl">
          <div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-xl p-4">
            <i class="fa-solid fa-folder-tree text-sky-300 text-xl mb-2"></i>
            <div class="font-bold text-sm">Akses Mengikut Unit</div>
            <p class="text-xs text-blue-100/80 mt-1">Setiap pegawai hanya melihat program & dokumen unit yang didaftarkan.</p>
          </div>
          <div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-xl p-4">
            <i class="fa-solid fa-cloud-arrow-up text-emerald-300 text-xl mb-2"></i>
            <div class="font-bold text-sm">Auto-Ekstrak PDF/DOCX</div>
            <p class="text-xs text-blue-100/80 mt-1">Kesan automatik Kertas Kerja & Laporan serta pautkan ke Google Drive.</p>
          </div>
          <div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-xl p-4">
            <i class="fa-solid fa-chart-pie text-amber-300 text-xl mb-2"></i>
            <div class="font-bold text-sm">Pemantauan Status</div>
            <p class="text-xs text-blue-100/80 mt-1">Status bertukar LENGKAP sebaik sahaja Kertas Kerja & Laporan disahkan.</p>
          </div>
        </div>
      </div>

      <!-- Baris Bawah: Pemilihan Akaun Demo Pantas -->
      <div class="relative z-10 bg-slate-900/40 backdrop-blur-md rounded-2xl p-4 border border-white/15">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-300 flex items-center gap-1.5">
            <i class="fa-solid fa-bolt"></i> Akses Demo Pantas (Satu Klik Untuk Menguji Kawalan Akses Unit):
          </span>
          <span class="text-[11px] text-blue-200">Kata laluan demo: <code class="bg-white/10 px-1.5 py-0.5 rounded">123456</code></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <button onclick="quickDemoLogin('admin', '123456')" class="px-3 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-left transition flex items-center gap-2.5">
            <i class="fa-solid fa-user-shield text-amber-300 text-lg"></i>
            <div>
              <div class="text-xs font-bold text-white">ADMIN HEP</div>
              <div class="text-[10px] text-amber-200">Akses Semua Jabatan/Unit</div>
            </div>
          </button>
          <button onclick="quickDemoLogin('aina', '123456')" class="px-3 py-2 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 border border-sky-400/40 text-left transition flex items-center gap-2.5">
            <i class="fa-solid fa-user-check text-sky-300 text-lg"></i>
            <div>
              <div class="text-xs font-bold text-white">USER: Nur Aina</div>
              <div class="text-[10px] text-sky-200">Unit Kaunseling (U001)</div>
            </div>
          </button>
          <button onclick="quickDemoLogin('farid', '123456')" class="px-3 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/40 text-left transition flex items-center gap-2.5">
            <i class="fa-solid fa-user-tag text-emerald-300 text-lg"></i>
            <div>
              <div class="text-xs font-bold text-white">USER: Mohd Farid</div>
              <div class="text-[10px] text-emerald-200">Unit Kebajikan (U002)</div>
            </div>
          </button>
        </div>
      </div>
    </div>

    <!-- Panel Kanan: Kad Borang Log Masuk / Pendaftaran / Lupa Kata Laluan -->
    <div class="lg:w-5/12 flex items-center justify-center p-6 sm:p-10 bg-gradient-to-br from-slate-50 via-white to-blue-50">
      <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200/80 p-7 sm:p-9">

        <!-- TAB 1: BORANG LOG MASUK -->
        <div id="loginFormContainer">
          <div class="flex flex-col items-center text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600 to-blue-800 text-white flex items-center justify-center shadow-lg mb-3">
              <i class="fa-solid fa-user-lock text-2xl"></i>
            </div>
            <h2 class="text-2xl font-extrabold text-slate-900">Log Masuk</h2>
            <p class="text-xs text-slate-500 mt-1">Akses ke sistem iDOC HEP mengikut Jabatan/Unit berdaftar</p>
          </div>

          <form onsubmit="handleLoginSubmit(event)" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Username</label>
              <div class="relative">
                <i class="fa-regular fa-user absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                <input type="text" id="loginUsername" required placeholder="Contoh: aina / farid / admin"
                  class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Kata Laluan</label>
              <div class="relative">
                <i class="fa-solid fa-lock absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                <input type="password" id="loginPassword" required placeholder="Masukkan kata laluan"
                  class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
                <button type="button" onclick="togglePasswordVisibility('loginPassword')" class="absolute right-3.5 top-2.5 text-slate-400 hover:text-slate-600">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>

            <div class="flex items-center justify-between text-xs">
              <label class="flex items-center gap-2 text-slate-600 cursor-pointer">
                <input type="checkbox" checked class="rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                <span>Ingat Saya</span>
              </label>
              <button type="button" onclick="switchAuthTab('forgot')" class="font-semibold text-blue-600 hover:text-blue-800">
                Lupa Kata Laluan?
              </button>
            </div>

            <button type="submit" class="w-full py-3 rounded-xl text-white font-bold text-sm btn-primary-grad flex items-center justify-center gap-2 shadow-md">
              <i class="fa-solid fa-right-to-bracket"></i>
              <span>Log Masuk</span>
            </button>
          </form>

          <div class="relative my-6 flex items-center justify-center">
            <div class="border-t border-slate-200 w-full"></div>
            <span class="bg-white px-3 text-xs text-slate-400 font-medium">atau</span>
            <div class="border-t border-slate-200 w-full"></div>
          </div>

          <button type="button" onclick="switchAuthTab('register')"
            class="w-full py-2.5 rounded-xl border-2 border-blue-600 text-blue-700 hover:bg-blue-50 font-bold text-sm transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-user-plus"></i>
            <span>Daftar Akaun Baharu</span>
          </button>
        </div>

        <!-- TAB 2: BORANG PENDAFTARAN PENGGUNA (KEPERLUAN A) -->
        <div id="registerFormContainer" class="hidden">
          <div class="flex flex-col items-center text-center mb-5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 text-white flex items-center justify-center shadow-md mb-2">
              <i class="fa-solid fa-user-plus text-xl"></i>
            </div>
            <h2 class="text-xl font-extrabold text-slate-900">Pendaftaran Pengguna</h2>
            <p class="text-xs text-slate-500">Pilih Jabatan/Unit anda. Unit tidak boleh ditukar sendiri selepas mendaftar.</p>
          </div>

          <form onsubmit="handleRegisterSubmit(event)" class="space-y-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">1. Nama Penuh</label>
              <input type="text" id="regFullName" required placeholder="Contoh: Siti Hajar binti Othman"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">2. Username</label>
                <input type="text" id="regUsername" required placeholder="Contoh: sitihajar"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">3. E-mel Rasmi</label>
                <input type="email" id="regEmail" required placeholder="nama@ptss.edu.my"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                4. No. Telefon (WhatsApp) <span class="text-[11px] font-normal text-emerald-600">(Untuk notifikasi peringatan dokumen)</span>
              </label>
              <div class="relative">
                <i class="fa-brands fa-whatsapp absolute left-3.5 top-2.5 text-emerald-600 text-base"></i>
                <input type="tel" id="regPhone" required placeholder="Contoh: 0123456789 atau 60123456789"
                  class="w-full pl-10 pr-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">
                5. Jabatan / Unit <span class="text-[11px] font-normal text-blue-600">(Data langsung tab JABATAN_UNIT)</span>
              </label>
              <select id="regUnitSelect" required
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-600">
                <!-- Diisi secara dinamik daripada getUnits() yang berstatus ACTIVE sahaja -->
              </select>
              <p class="text-[11px] text-amber-700 mt-1 flex items-center gap-1">
                <i class="fa-solid fa-circle-info"></i>
                Hanya unit berstatus ACTIVE dipaparkan. Unit dikunci selepas pendaftaran.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">6. Kata Laluan</label>
                <input type="password" id="regPassword" required minlength="6" placeholder="Min. 6 aksara"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">7. Sahkan Kata Laluan</label>
                <input type="password" id="regConfirmPassword" required minlength="6" placeholder="Ulang kata laluan"
                  class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600">
              </div>
            </div>

            <button type="submit" class="w-full py-2.5 rounded-xl text-white font-bold text-sm btn-primary-grad shadow-md mt-2">
              <i class="fa-solid fa-check-circle mr-1"></i> Daftar & Terus Log Masuk
            </button>
          </form>

          <button type="button" onclick="switchAuthTab('login')"
            class="w-full mt-3 py-2 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-semibold text-xs">
            Kembali ke Log Masuk
          </button>
        </div>

        <!-- TAB 3: BORANG LUPA KATA LALUAN -->
        <div id="forgotFormContainer" class="hidden">
          <div class="flex flex-col items-center text-center mb-5">
            <div class="w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center shadow-md mb-2">
              <i class="fa-solid fa-key text-xl"></i>
            </div>
            <h2 class="text-xl font-extrabold text-slate-900">Set Semula Kata Laluan</h2>
            <p class="text-xs text-slate-500">Masukkan Username & E-mel berdaftar anda untuk menukar kata laluan baharu.</p>
          </div>

          <form onsubmit="handleForgotSubmit(event)" class="space-y-3.5">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Username</label>
              <input type="text" id="forgotUsername" required placeholder="Username anda"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">E-mel Rasmi Berdaftar</label>
              <input type="email" id="forgotEmail" required placeholder="nama@ptss.edu.my"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Kata Laluan Baharu</label>
              <input type="password" id="forgotNewPass" required minlength="6" placeholder="Masukkan kata laluan baharu"
                class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm">
            </div>
            <button type="submit" class="w-full py-2.5 rounded-xl text-white font-bold text-sm btn-primary-grad">
              Simpan Kata Laluan Baharu
            </button>
          </form>

          <button type="button" onclick="switchAuthTab('login')"
            class="w-full mt-3 py-2 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-100 font-semibold text-xs">
            Kembali ke Log Masuk
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- =========================================================================
       SKRIN 2: APLIKASI UTAMA (SIDEBAR + TOPBAR + RUANG KERJA DINAMIK)
       ========================================================================= -->
  <div id="appScreen" class="hidden min-h-screen flex flex-col lg:flex-row">

    <!-- SIDEBAR NAVIGASI (DENGAN FUNGSI HIDE/UNHIDE DAN SUSUNAN IKUT IMEJ #2) -->
    <aside id="appSidebar" class="w-64 sidebar-gradient text-white flex flex-col justify-between shrink-0 shadow-xl z-20 transition-all duration-300">
      <div>
        <!-- Brand Header dengan butang tutup sidebar pada mudah alih -->
        <div class="p-4 flex items-center justify-between border-b border-white/10">
          <div class="flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center shadow-md border border-white/50">
              <i class="fa-solid fa-file-lines text-white text-base"></i>
            </div>
            <div>
              <div class="font-extrabold text-base tracking-tight leading-none">iDOC <span class="text-sky-300">HEP</span></div>
              <div class="text-[9px] text-blue-200 mt-0.5">PTSS Perlis</div>
            </div>
          </div>
          <button onclick="toggleSidebar()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
            <i class="fa-solid fa-bars text-sm"></i>
          </button>
        </div>

        <!-- Senarai Menu Dinamik (Tersusun seperti imej #2) -->
        <nav id="sidebarNavLinks" class="p-3 space-y-1 overflow-y-auto max-h-[calc(100vh-140px)]">
          <!-- Dijana oleh renderSidebarMenu() -->
        </nav>
      </div>

      <!-- Footer Sidebar Google Sheet ID Indicator -->
      <div class="p-3 m-3 rounded-xl bg-white/10 border border-white/10 text-[10px] space-y-1">
        <div class="flex items-center justify-between text-blue-200">
          <span>Google Sheet DB:</span>
          <span class="px-1.5 py-0.5 rounded bg-emerald-500/30 text-emerald-200 font-bold">CONNECTED</span>
        </div>
        <div class="font-mono text-[9px] text-sky-200 truncate" title="1nW0DEFCj6B3k89SOfzMhQoNVk7SkSLs-a27jakOzmfE">
          ID: 1nW0DEFCj6B3k8...
        </div>
      </div>
    </aside>

    <!-- KANDUNGAN UTAMA -->
    <div class="flex-1 flex flex-col min-w-0">

      <!-- TOP HEADER BAR (DENGAN BUTANG TOGGLE SIDEBAR HIDE/UNHIDE) -->
      <header class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 sticky top-0 z-10 shadow-2xs">
        <div class="flex items-center gap-3">
          <button onclick="toggleSidebar()" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition" title="Sembunyikan / Paparkan Sidebar">
            <i class="fa-solid fa-outdent text-sm"></i>
          </button>
          <div>
            <div class="text-xs sm:text-sm font-bold text-slate-800">Sistem Pengurusan Dokumen Jabatan Hal Ehwal Pelajar</div>
            <div class="text-[11px] text-slate-500">Politeknik Tuanku Syed Sirajuddin, Perlis</div>
          </div>
        </div>

        <!-- Alat Kawalan Kanan: Tukar Akaun Demo Pantas, Ujian RBAC & Profil -->
        <div class="flex items-center gap-2 sm:gap-3">
          <button onclick="openSecurityAuditModal()" class="px-3 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 text-xs font-bold flex items-center gap-1.5 transition">
            <i class="fa-solid fa-shield-halved"></i>
            <span class="hidden md:inline">Ujian RBAC & GAS</span>
          </button>

          <select id="quickSessionSwitcher" onchange="handleQuickSessionSwitch(this.value)"
            class="px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold border border-slate-300 focus:outline-none">
          </select>

