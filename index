    const BackendService = {
      nowStr() {
        const d = new Date();
        return d.toISOString().slice(0, 19).replace('T', ' ');
      },
      normalizeWhatsAppPhone(phone) {
        if (!phone) return '60123456789';
        let clean = phone.replace(/\D/g, '');
        if (clean.startsWith('0')) clean = '6' + clean;
        if (!clean.startsWith('60')) clean = '60' + clean;
        return clean;
      },
      getUnitNameById(unitId) {
        const u = DB.JABATAN_UNIT.find(x => x.unit_id === unitId);
        return u ? u.nama_unit : (unitId === 'ALL' ? 'Semua Unit' : unitId);
      },
      extractGoogleIdFromUrl(urlOrId) {
        if (!urlOrId) return '';
        const trimmed = urlOrId.trim();
        if (!trimmed.includes('/')) return trimmed;
        const matchFolder = trimmed.match(/\/folders\/([a-zA-Z0-9-_]+)/);
        if (matchFolder) return matchFolder[1];
        const matchFile = trimmed.match(/\/file\/d\/([a-zA-Z0-9-_]+)/);
        if (matchFile) return matchFile[1];
        const matchDocs = trimmed.match(/\/d\/([a-zA-Z0-9-_]+)/);
        if (matchDocs) return matchDocs[1];
        return trimmed;
      },
      getCurrentUser(token) {
        if (!token || !DB.SESSIONS[token]) {
          throw new Error('SESI_TAMAT: Sila log masuk semula.');
        }
        const session = DB.SESSIONS[token];
        const user = DB.PENGGUNA.find(u => u.user_id === session.user_id && u.status === 'ACTIVE');
        if (!user) throw new Error('AKAUN_TIDAK_SAH: Pengguna tidak aktif.');
        const unitObj = DB.JABATAN_UNIT.find(un => un.unit_id === user.unit_id);
        return {
          ...user,
          nama_unit: unitObj ? unitObj.nama_unit : (user.unit_id === 'ALL' ? 'Semua Jabatan/Unit' : user.unit_id)
        };
      },
      checkUnitAccess(token, targetUnitId, contextInfo) {
        const user = this.getCurrentUser(token);
        if (user.role === 'ADMIN') return user;
        if (user.role === 'USER' && user.unit_id === targetUnitId) return user;
        this.logAudit(user, 'UNAUTHORIZED_ACCESS', 'BLOCKED', `Cuba akses unit ${targetUnitId} (${contextInfo})`);
        throw new Error(`AKSES_DITOLAK (403): Rekod milik Jabatan/Unit lain (${targetUnitId}).`);
      },
      logAudit(user, action, status, details) {
        const newLog = {
          log_id: 'LOG' + String(DB.LOG_AKTIVITI.length + 1).padStart(3, '0'),
          timestamp: this.nowStr(),
          user_id: user ? user.user_id : 'SYS',
          username: user ? user.username : 'system',
          role: user ? user.role : 'SYSTEM',
          unit_id: user ? user.unit_id : '-',
          action,
          status,
          details
        };
        DB.LOG_AKTIVITI.unshift(newLog);
      },
      getUnits(token, includeInactive) {
        if (!token) {
          return DB.JABATAN_UNIT.filter(u => u.status === 'ACTIVE');
        }
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK: Khusus Admin.');
        return DB.JABATAN_UNIT.map(u => {
          const userCount = DB.PENGGUNA.filter(p => p.unit_id === u.unit_id).length;
          const progCount = DB.PROGRAM.filter(p => p.unit_id === u.unit_id).length;
          const docCount = DB.DOKUMEN.filter(d => d.unit_id === u.unit_id).length;
          return { ...u, userCount, progCount, docCount };
        }).filter(u => includeInactive || u.status === 'ACTIVE');
      },
      createUnit(token, payload) {
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK.');
        const newId = 'U00' + (DB.JABATAN_UNIT.length + 1);
        const now = this.nowStr();
        const unit = {
          unit_id: newId,
          nama_unit: payload.nama_unit,
          keterangan: payload.keterangan || '',
          status: 'ACTIVE',
          created_at: now,
          updated_at: now
        };
        DB.JABATAN_UNIT.push(unit);
        this.logAudit(user, 'CREATE_UNIT', 'SUCCESS', `Tambah Jabatan/Unit ${newId} (${payload.nama_unit})`);
        return unit;
      },
      updateUnit(token, unitId, payload) {
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK.');
        const unit = DB.JABATAN_UNIT.find(u => u.unit_id === unitId);
        if (!unit) throw new Error('Unit tidak ditemui.');
        unit.nama_unit = payload.nama_unit || unit.nama_unit;
        unit.keterangan = payload.keterangan !== undefined ? payload.keterangan : unit.keterangan;
        unit.status = payload.status || unit.status;
        unit.updated_at = this.nowStr();
        this.logAudit(user, 'UPDATE_UNIT', 'SUCCESS', `Kemaskini Jabatan/Unit ${unitId}`);
        return unit;
      },
      deactivateUnit(token, unitId) {
        const user = this.getCurrentUser(token);
        if (user.role !== 'ADMIN') throw new Error('AKSES_DITOLAK.');
        const unit = DB.JABATAN_UNIT.find(u => u.unit_id === unitId);
        if (!unit) throw new Error('Unit tidak ditemui.');
        unit.status = unit.status === 'ACTIVE' ? 'INACTIVE' : 'ACTIVE';
        unit.updated_at = this.nowStr();
        const linkedUsers = DB.PENGGUNA.filter(p => p.unit_id === unitId).length;
        const linkedProgs = DB.PROGRAM.filter(p => p.unit_id === unitId).length;
        this.logAudit(user, 'DEACTIVATE_UNIT', 'SUCCESS', `Tukar status unit ${unitId} kepada ${unit.status} (Soft delete diaktifkan)`);
        return { ...unit, linkedUsers, linkedProgs };
      },
      getUserPrograms(token, filters = {}) {
        const user = this.getCurrentUser(token);
        const { tahun = '2026', status = 'ALL', search = '' } = filters;

        return DB.PROGRAM.filter(p => {
          if (user.role !== 'ADMIN' && p.unit_id !== user.unit_id) return false;
          if (tahun !== 'ALL' && p.tahun !== tahun) return false;
          if (status !== 'ALL' && p.status_dokumen !== status) return false;
          if (search && !p.nama_program.toLowerCase().includes(search.toLowerCase())) return false;
          return true;
        }).map(p => {
          const docs = DB.DOKUMEN.filter(d => d.program_id === p.program_id);
          const hasKK = docs.some(d => d.jenis_dokumen === 'Kertas Kerja');
          const hasLap = docs.some(d => d.jenis_dokumen === 'Laporan');
          const unitObj = DB.JABATAN_UNIT.find(u => u.unit_id === p.unit_id);
          const pegawaiUnit = DB.PENGGUNA.find(u => u.unit_id === p.unit_id && u.role === 'USER') || DB.PENGGUNA.find(u => u.role === 'USER');

          return {
            ...p,
            nama_unit: unitObj ? unitObj.nama_unit : p.unit_id,
            has_kertas_kerja: hasKK,
            has_laporan: hasLap,
            jenis_dokumen_ringkasan: docs.map(d => d.jenis_dokumen).join(', ') || 'Tiada',
            pegawai_phone: pegawaiUnit ? pegawaiUnit.phone : '60123456789'
          };
