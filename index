    function runAllSixVerificationTests() {
      const results = [];
      const tokKaunseling = 'TEST_SES_U001';
      const tokKebajikan = 'TEST_SES_U002';
      const tokAdmin = 'TEST_SES_ADMIN';
      DB.SESSIONS[tokKaunseling] = { user_id: 'USR002', created_at: BackendService.nowStr() };
      DB.SESSIONS[tokKebajikan] = { user_id: 'USR003', created_at: BackendService.nowStr() };
      DB.SESSIONS[tokAdmin] = { user_id: 'USR001', created_at: BackendService.nowStr() };

      const progsKaunseling = BackendService.getUserPrograms(tokKaunseling, {});
      const hasKebajikanInList = progsKaunseling.some(p => p.unit_id === 'U002');
      results.push({
        title: '1. User Unit Kaunseling (U001) tidak boleh melihat program Unit Kebajikan (U002)',
        passed: !hasKebajikanInList && progsKaunseling.every(p => p.unit_id === 'U001'),
        detail: `getUserPrograms() memulangkan ${progsKaunseling.length} program U001 dan 0 program U002.`
      });

      let blockedCrossDoc = false;
      let blockMsg = '';
      try {
        BackendService.openDocumentSecurely(tokKebajikan, 'DOC202601');
      } catch (err) {
        blockedCrossDoc = true;
        blockMsg = err.message;
      }
      results.push({
        title: '2. User Unit Kebajikan (U002) dihalang membuka dokumen Unit Kaunseling',
        passed: blockedCrossDoc,
        detail: `Disekat oleh checkUnitAccess() di backend: "${blockMsg}"`
      });

      const adminProgs = BackendService.getAdminPrograms(tokAdmin, { unit_id: 'ALL' });
      const distinctUnits = [...new Set(adminProgs.map(p => p.unit_id))];
      results.push({
        title: '3. Admin boleh melihat semua program daripada semua Jabatan/Unit',
        passed: distinctUnits.length >= 2,
        detail: `getAdminPrograms() memulangkan program merentasi ${distinctUnits.length} unit.`
      });

      const beforeCount = BackendService.getUserPrograms(tokKaunseling, {}).length;
      const newAdminProg = BackendService.saveAdminProgram(tokAdmin, {
        nama_program: 'Seminar Psikologi Siswa (Ujian)',
        unit_id: 'U001',
        tarikh_mula: '2026-10-12',
        tarikh_tamat: '2026-10-12',
        dana_id: 'D001',
        peruntukan: 2000
      });
      const afterProgs = BackendService.getUserPrograms(tokKaunseling, {});
      const foundInUser = afterProgs.some(p => p.program_id === newAdminProg.program_id);
      BackendService.deleteAdminProgram(tokAdmin, newAdminProg.program_id);
      results.push({
        title: '4. Program baharu yang Admin tambah muncul kepada pengguna unit berkenaan',
        passed: foundInUser && afterProgs.length === beforeCount + 1,
        detail: `Program ${newAdminProg.program_id} muncul secara automatik.`
      });

      let blockedCrossUpload = false;
      try {
        BackendService.uploadUserDocument(tokKaunseling, {
          program_id: 'P2026002',
          jenis_dokumen: 'Kertas Kerja',
          nama_fail: 'Test.pdf'
        });
      } catch (e) {
        blockedCrossUpload = true;
      }
      results.push({
        title: '5. Upload oleh User dikunci kepada unit sendiri & halang pautan ke program unit lain',
        passed: blockedCrossUpload,
        detail: `Cubaan muat naik silang unit disekat dengan jayanya.`
      });

      const originalName = DB.JABATAN_UNIT.find(u => u.unit_id === 'U001').nama_unit;
      BackendService.updateUnit(tokAdmin, 'U001', { nama_unit: 'Unit Psikologi PTSS' });
      const progsAfterRename = BackendService.getUserPrograms(tokKaunseling, {});
      const userAfterRename = BackendService.getCurrentUser(tokKaunseling);
      const renameIntact = progsAfterRename.length === beforeCount && userAfterRename.nama_unit === 'Unit Psikologi PTSS';
      BackendService.updateUnit(tokAdmin, 'U001', { nama_unit: originalName });
      results.push({
        title: '6. Pertukaran nama unit tidak merosakkan hubungan rekod (Kunci unit_id stabil)',
        passed: renameIntact,
        detail: `Hubungan rekod kekal terpaut melalui unit_id=U001.`
      });

      delete DB.SESSIONS[tokKaunseling];
      delete DB.SESSIONS[tokKebajikan];
      delete DB.SESSIONS[tokAdmin];

      const container = document.getElementById('testResultsContainer');
      if (container) {
        container.innerHTML = results.map(r => `
          <div class="p-3.5 rounded-xl border ${r.passed ? 'bg-emerald-50/70 border-emerald-200' : 'bg-rose-50 border-rose-200'} flex items-start gap-3">
            <i class="fa-solid ${r.passed ? 'fa-circle-check text-emerald-600' : 'fa-circle-xmark text-rose-600'} text-lg mt-0.5"></i>
            <div>
              <div class="font-bold text-slate-900">${r.title} — <span class="${r.passed ? 'text-emerald-700' : 'text-rose-700'}">${r.passed ? 'LULUS (PASS)' : 'GAGAL'}</span></div>
              <div class="text-slate-600 mt-0.5">${r.detail}</div>
            </div>
          </div>
        `).join('');
      }
    }

