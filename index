        showToast('Akaun anda tidak aktif. Sila hubungi Pentadbir HEP.', 'warning');
        return;
      }

      showToast(`Selamat datang, ${found.full_name} (${BackendService.getUnitNameById(found.unit_id)})!`, 'success');
      createSessionAndEnterApp(found);
