      },
      getAdminPrograms(token, filters = {}) {
        return this.getUserPrograms(token, filters);
      },
      getUserDocuments(token, programId) {
        const user = this.getCurrentUser(token);
        const prog = DB.PROGRAM.find(p => p.program_id === programId);
        if (!prog) throw new Error('Program tidak ditemui.');
        this.checkUnitAccess(token, prog.unit_id, `getUserDocuments(${programId})`);
        return DB.DOKUMEN.filter(d => d.program_id === programId);
      },
      uploadUserDocument(token, payload) {
        const user = this.getCurrentUser(token);
        let program;

        if (payload.program_id && payload.program_id !== 'AUTO_MATCH') {
          program = DB.PROGRAM.find(p => p.program_id === payload.program_id);
          if (!program) throw new Error('Program tidak ditemui.');
          this.checkUnitAccess(token, program.unit_id, 'uploadUserDocument');
        } else {
          program = DB.PROGRAM.find(p => p.unit_id === user.unit_id && p.nama_program.toLowerCase().includes(payload.extracted_nama_program.toLowerCase().slice(0, 8)));
          if (!program) {
            program = {
              program_id: 'P2026' + String(DB.PROGRAM.length + 1).padStart(3, '0'),
              nama_program: payload.extracted_nama_program || 'Program Baharu Unit',
              tarikh_mula: payload.extracted_tarikh || '2026-04-20',
              tarikh_tamat: payload.extracted_tarikh || '2026-04-20',
              tahun: '2026',
              sesi: 'Sesi I 2025/2026',
              unit_id: user.unit_id,
              dana_id: 'D001',
              peruntukan: 3000,
              belanja_sebenar: 0,
              disediakan_oleh: payload.extracted_disediakan_oleh || user.full_name,
              status_dokumen: 'SEPARUH LENGKAP',
              created_at: this.nowStr().slice(0, 10)
            };
            DB.PROGRAM.push(program);
          } else {
            this.checkUnitAccess(token, program.unit_id, 'uploadUserDocument auto-match');
          }
        }

        const docId = 'DOC' + String(Date.now()).slice(-6);
        const customId = this.extractGoogleIdFromUrl(payload.custom_drive_link);
        const driveFileId = customId || ('1DRV_' + program.unit_id + '_' + program.program_id + '_' + Math.random().toString(36).substring(2, 6).toUpperCase());
        const folderPath = `${DB.TETAPAN_SISTEM.root_folder_name}/2026/${program.unit_id}/${program.program_id}/${payload.jenis_dokumen}/`;

        const newDoc = {
          document_id: docId,
          program_id: program.program_id,
          unit_id: program.unit_id,
          jenis_dokumen: payload.jenis_dokumen,
          nama_fail: payload.nama_fail || 'Dokumen_Upload.pdf',
          drive_file_id: driveFileId,
          drive_direct_url: payload.custom_drive_link || `https://drive.google.com/file/d/${driveFileId}/view`,
          drive_folder_path: folderPath,
          disediakan_oleh: payload.extracted_disediakan_oleh || user.full_name,
          tarikh_muat_naik: this.nowStr().slice(0, 10),
          status_pengesahan: 'DISAHKAN'
        };

        DB.DOKUMEN.push(newDoc);

        const docs = DB.DOKUMEN.filter(d => d.program_id === program.program_id);
        const hasKK = docs.some(d => d.jenis_dokumen === 'Kertas Kerja');
        const hasLap = docs.some(d => d.jenis_dokumen === 'Laporan');
        if (hasKK && hasLap) {
          program.status_dokumen = 'LENGKAP';
        } else if (hasKK || hasLap) {
          program.status_dokumen = 'SEPARUH LENGKAP';
        }

        this.logAudit(user, 'UPLOAD_DOCUMENT', 'SUCCESS', `Muat naik ${payload.jenis_dokumen} (${payload.nama_fail}) terpaut pada program ${program.program_id} (${program.unit_id})`);
        return { document: newDoc, program };
      },
      openDocumentSecurely(token, documentId) {
        const user = this.getCurrentUser(token);
        const doc = DB.DOKUMEN.find(d => d.document_id === documentId);
        if (!doc) throw new Error('Dokumen tidak ditemui.');
        this.checkUnitAccess(token, doc.unit_id, `openDocumentSecurely(${documentId})`);
        this.logAudit(user, 'SECURE_DOCUMENT_ACCESS', 'SUCCESS', `Akses selamat fail ${documentId} (${doc.nama_fail})`);
        return {
          ...doc,
          nama_unit: this.getUnitNameById(doc.unit_id),
          secure_stream_token: 'STRM_' + Math.random().toString(36).substring(2, 10)
